 import 'partitions_service.activator.g.dart';
 
 part 'partitions_service.worker.g.dart';
@@ -27,4 +29,22 @@ base class PartitionsService {
     _log.fine('echo $input');
     return input;
   }
+
+  /// Which way this place would fetch a partition, and what it passed over.
+  @squadronMethod
+  Future<String> howToFetch() async =>
+      fetchPartition.selectRead(await PlaceInfo.current()).why;
+
+  /// Copies [partition]'s image into [outDir], the way this place can: `dd`
+  /// in the root process on the device, `fastboot fetch` on a computer.
+  @squadronMethod
+  Future<Map<String, String>> fetch(String partition, String outDir) async {
+    final place = await PlaceInfo.current();
+    final request = FetchRequest(partition, outDir);
+    final strategy = fetchPartition.selectRead(place).chosen?.name ?? 'none';
