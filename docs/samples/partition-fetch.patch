 }
diff --git a/core/lib/src/strategy/fetch_partition.dart b/core/lib/src/strategy/fetch_partition.dart
index e5070fa..cde48a0 100644
--- a/core/lib/src/strategy/fetch_partition.dart
+++ b/core/lib/src/strategy/fetch_partition.dart
@@ -1,42 +1,98 @@
+import 'dart:io';
+
 import '../facts/facts.dart';
 import 'objective.dart';
 import 'strategy.dart';
 
-/// Fetch partition: its strategies, in preference order. The first
-/// whose `available(facts)` holds in the place runs.
-final fetchPartition = Objective<String, String>('fetch_partition', const [
-  FetchPartitionDd(),
-  FetchPartitionFastbootFetch(),
-]);
+/// What to fetch, and where to put the image.
+final class FetchRequest {
+  const FetchRequest(this.partition, this.outDir);
+
+  /// The partition's name, as in `/dev/block/by-name/` (`boot_a`, `init_boot`).
+  final String partition;
+  final String outDir;
+
+  String get outPath => '$outDir/$partition.img';
+}
+
+/// Fetch partition: copy one partition's image to a file. On the device, as
+/// root, `dd` reads the block device; from a computer with the device in
+/// fastboot(d), `fastboot fetch` pulls it over USB. Same objective, two
+/// places: which one runs is decided by the facts of the place the partitions
+/// service runs in, never by the platform.
+final fetchPartition = Objective<FetchRequest, String>(
+  'fetch_partition',
+  const [FetchPartitionDd(), FetchPartitionFastbootFetch()],
+);
+
+/// On the device: `dd` from `/dev/block/by-name/<partition>`.
+final class FetchPartitionDd extends ReadStrategy<FetchRequest, String> {
+  const FetchPartitionDd({this.byName = '/dev/block/by-name'});
 
-/// Fetch partition via dd.
-final class FetchPartitionDd extends ReadStrategy<String, String> {
-  const FetchPartitionDd();
+  /// Where the device's partitions are listed by name.
+  final String byName;
 
   @override
   String get name => 'dd';
 
-  /// The facts this strategy cannot run without, e.g. `{Fact.root}`.
   @override
-  Set<String> get requires => const {};
+  Set<String> get requires => const {
+    Fact.root,
+    Fact.blockDevices,
+    Fact.processSpawn,
+  };
 
   @override
-  Future<String> run(String input, PlaceInfo place) =>
-      throw UnimplementedError('fetch_partition via dd');
+  Future<String> run(FetchRequest input, PlaceInfo place) async {
+    final r = await Process.run('dd', [
+      'if=$byName/${input.partition}',
+      'of=${input.outPath}',
+      'bs=4M',
+    ]);
+    if (r.exitCode != 0) {
+      throw ProcessException('dd', const [], '${r.stderr}', r.exitCode);
+    }
+    return input.outPath;
+  }
 }
 
-/// Fetch partition via fastboot fetch.
-final class FetchPartitionFastbootFetch extends ReadStrategy<String, String> {
+/// From a computer: `fastboot fetch <partition> <file>` (needs fastbootd on
+/// the device, and only some partitions can be fetched).
+final class FetchPartitionFastbootFetch
+    extends ReadStrategy<FetchRequest, String> {
   const FetchPartitionFastbootFetch();
 
   @override
   String get name => 'fastboot_fetch';
 
-  /// The facts this strategy cannot run without, e.g. `{Fact.root}`.
   @override
-  Set<String> get requires => const {};
+  Set<String> get requires => const {
+    Fact.fastboot,
+    Fact.usbNative,
+    Fact.processSpawn,
+  };
+
+  /// A place with root and block devices is the device itself; fastboot
+  /// would talk to some other device, so don't offer it there.
+  @override
+  Availability available(Facts facts) {
+    final base = super.available(facts);
+    if (!base.ok) return base;
+    return facts.has(Fact.root) && facts.has(Fact.blockDevices)
+        ? Availability(name, note: 'this place is the device')
+        : base;
+  }
 
   @override
-  Future<String> run(String input, PlaceInfo place) =>
-      throw UnimplementedError('fetch_partition via fastboot_fetch');
+  Future<String> run(FetchRequest input, PlaceInfo place) async {
+    final r = await Process.run('fastboot', [
+      'fetch',
+      input.partition,
+      input.outPath,
+    ]);
+    if (r.exitCode != 0) {
+      throw ProcessException('fastboot', const [], '${r.stderr}', r.exitCode);
+    }
+    return input.outPath;
+  }
 }
